# ── Runtime mode ──────────────────────────────────────────────────────────────
# Set to true to use a local SQLite file instead of PostgreSQL.
# Use false for all real environments (Docker, staging, production).
USE_SQLITE=false

# ── PostgreSQL + PostGIS connection ───────────────────────────────────────────
# Required when USE_SQLITE=false.
# The Docker Compose stack exposes PostgreSQL on localhost:5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=austin-traffic-predictor
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── External API keys ─────────────────────────────────────────────────────────
# TomTom Traffic Flow API  →  https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here

# OpenWeatherMap Current Weather API  →  https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Ticketmaster Discovery API  →  https://developer.ticketmaster.com
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Socrata App Token (optional) — raises Austin Open Data rate limit from
# 1,000 req/hr (anonymous) to 10,000 req/hr.
# Register at https://data.austintexas.gov/profile/app_tokens
SOCRATA_APP_TOKEN=
