# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=austin_traffic
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# API Keys — obtain free keys from the links below before running the ETL scripts

# TomTom Traffic API: https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here

# OpenWeatherMap: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Ticketmaster Discovery API: https://developer.ticketmaster.com
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
