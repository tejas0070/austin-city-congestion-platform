# ── Backend .env ───────────────────────────────────────────────────────────────
# EVERYTHING here is OPTIONAL. With no .env at all the app runs on SQLite +
# committed model artifacts and silent fallbacks. Set only what you need.

# Optional — defaults to SQLite (sqlite:///./dev.db). Set to a Postgres URL to
# use Postgres instead, e.g. postgresql://user:password@localhost:5432/austin_traffic
# DATABASE_URL=

# Optional — Ticketmaster events (free tier)
TICKETMASTER_API_KEY=

# Optional — raises Austin open-data (Socrata) rate limit
SOCRATA_APP_TOKEN=

# Optional — TomTom Traffic Flow (free dev tier). Powers real per-segment
# congestion collection (scripts/collect_tomtom_observations.py) and the 6-hour
# self-update loop. Get a free key at https://developer.tomtom.com
TOMTOM_API_KEY=

# Optional — extra browser origins allowed by CORS (comma-separated), for a custom
# frontend domain. *.netlify.app / *.vercel.app / *.pages.dev already work.
# ALLOWED_ORIGINS=

# ── Frontend .env (place in frontend/.env) ─────────────────────────────────────
# No Mapbox token needed — the map uses MapLibre + Carto.
# REACT_APP_API_BASE_URL=http://localhost:8000
