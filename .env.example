# ── Backend .env ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/austin_traffic

# Optional — raises Austin 311 rate limit
SOCRATA_APP_TOKEN=

# Required for Ticketmaster events (free tier)
TICKETMASTER_API_KEY=

# Optional — TxDOT enhanced feed access
TXDOT_API_KEY=

# Optional — TomTom Traffic Flow (free dev tier). Powers real per-segment
# congestion collection (scripts/collect_tomtom_observations.py) that expands the
# model's real coverage. Get a free key at https://developer.tomtom.com
TOMTOM_API_KEY=

# ── Frontend .env (place in frontend/.env) ─────────────────────────────────────
# REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here
# REACT_APP_API_BASE_URL=http://localhost:8000
