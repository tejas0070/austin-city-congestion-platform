# Secrets — never commit these
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo

# ML model artifacts — binary files, regenerate with ml/train.py
ml/models/
*.joblib

# Data files — regenerate with etl/ scripts
data/raw/
data/processed/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Local SQLite database (dev only)
*.db

# OSM/API response cache (large binary blobs, regenerated at runtime)
cache/

# Docker volumes & OS
.DS_Store
Thumbs.db

# Superpowers brainstorming tool runtime state
.superpowers/
