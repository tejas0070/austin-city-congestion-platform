# Secrets — never commit these
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo

# ML model artifacts — binary files, regenerate with ml/train.py
ml/models/
*.joblib

# Data files — regenerate with etl/ scripts
data/raw/
data/processed/
# Large regenerable ML training data — rebuild with scripts/generate_training_data.py
data/training/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Local SQLite database (dev only)
*.db

# OSM/API response cache (large binary blobs, regenerated at runtime)
cache/

# Docker volumes & OS
.DS_Store
Thumbs.db

# Superpowers brainstorming tool runtime state
.superpowers/

# Node modules — frontend dependencies
node_modules/
frontend/node_modules/
frontend/build/
frontend/.env

# Python egg / dist
*.egg-info/
dist/
.venv/
venv/

# SQLite variants
*.sqlite3
dev.db

# IDE
.vscode/
.idea/

# Alembic pycache
alembic/versions/__pycache__/

# TomTom runtime budget counter (daily state, not an artifact)
data/models/tomtom_usage.json

# Internal security audit — kept local, not published to the public repo
/SECURITY.md
.playwright-mcp/
